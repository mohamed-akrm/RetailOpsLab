@model OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
}

<h1>Order Details</h1>

@if (Model.Order != null)
{
    <section class="panel">
        <p><strong>Order ID:</strong> @Model.Order.OrderId</p>
        <p><strong>Customer:</strong> @Model.Order.CustomerName</p>
        <p><strong>Status:</strong> @Model.Order.OrderStatus</p>
        <p><strong>Total:</strong> @Model.Order.TotalAmount.ToString("N2")</p>
    </section>
}

<table>
    <thead>
        <tr>
            <th>Product</th>
            <th>Warehouse</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Discount</th>
            <th>Line Total</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.WarehouseName</td>
            <td>@item.Quantity</td>
            <td>@item.UnitPrice.ToString("N2")</td>
            <td>@item.DiscountPercent.ToString("N2")%</td>
            <td>@item.LineTotal.ToString("N2")</td>
        </tr>
    }
    </tbody>
</table>
