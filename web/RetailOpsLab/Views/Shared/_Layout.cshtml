<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RetailOpsLab</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <div class="brand">RetailOpsLab</div>
        <nav>
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
            <a asp-controller="Customers" asp-action="Index">Customers</a>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <a asp-controller="Orders" asp-action="Index">Orders</a>
            <a asp-controller="Audit" asp-action="Index">Audit</a>
            <a asp-controller="Functions" asp-action="Index">Functions</a>
        </nav>
    </header>

    <main class="container">
        @if (TempData["Success"] != null)
        {
            <div class="success">@TempData["Success"]</div>
        }
        @RenderBody()
    </main>
</body>
</html>
