@model DashboardViewModel?
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<p class="muted">This page reads fast summary numbers by calling app.usp_GetDashboardNumbers.</p>

@if (ViewBag.ErrorMessage != null)
{
    <div class="danger">
        <strong>Database connection failed.</strong>
        <p>@ViewBag.ErrorMessage</p>
        <p>Check SQL Server, database creation, and the connection string in appsettings.json.</p>
    </div>
}
else if (Model != null)
{
    <div class="cards">
        <div class="card"><span>Customers</span><strong>@Model.CustomersCount.ToString("N0")</strong></div>
        <div class="card"><span>Products</span><strong>@Model.ProductsCount.ToString("N0")</strong></div>
        <div class="card"><span>Orders</span><strong>@Model.OrdersCount.ToString("N0")</strong></div>
        <div class="card"><span>Order Items</span><strong>@Model.OrderItemsCount.ToString("N0")</strong></div>
        <div class="card"><span>Audit Logs</span><strong>@Model.AuditLogsCount.ToString("N0")</strong></div>
    </div>
}
