@model List<CustomerViewModel>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-title">
    <h1>Customers</h1>
    <a class="button" asp-action="Create">Create Customer</a>
</div>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>City</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CustomerId</td>
            <td>@item.CustomerName</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td>@item.City</td>
            <td>@item.IsActive</td>
        </tr>
    }
    </tbody>
</table>
